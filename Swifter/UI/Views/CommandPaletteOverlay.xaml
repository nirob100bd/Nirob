<UserControl x:Class="Swifter.UI.Views.CommandPaletteOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="ResultRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#99000000" MouseLeftButtonDown="OnBackdropClick">
        <Border VerticalAlignment="Top" Margin="0,120,0,0" MaxWidth="640" MinWidth="420"
                Background="{DynamicResource GlassBrush}"
                BorderBrush="{DynamicResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="16,14,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⌘" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}" />
                    <TextBox x:Name="QueryBox"
                             Grid.Column="1"
                             FontSize="17"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             Padding="0"
                             KeyDown="OnQueryKeyDown"
                             TextChanged="OnQueryChanged"
                             ToolTip="Search tabs, history, bookmarks, actions — Ctrl+K" />
                </Grid>
                <Separator Grid.Row="1" Margin="12,0" Background="{DynamicResource BorderBrushLight}" />
                <TextBlock x:Name="CategoryHint" Grid.Row="2" Text="ACTIONS" FontSize="10" Margin="20,8,20,2" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                    <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Style="{StaticResource ResultRow}" MouseLeftButtonUp="OnResultClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Width="26" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#22000000" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="4" Background="#14000000" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↑↓ navigate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" />
                        <TextBlock Text="Enter open" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" />
                        <TextBlock Text="Esc close" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" />
                        <TextBlock x:Name="ResultCount" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="Swifter.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swifter Settings"
        Width="980" Height="720"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="20,16" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Background="{DynamicResource TabSurfaceBrush}">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="UsageLine" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource TabSurfaceBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList" SelectionChanged="OnNavSelection" BorderThickness="0" Background="Transparent" Margin="8">
                    <ListBoxItem Content="🎨  Appearance" IsSelected="True" />
                    <ListBoxItem Content="⚡  Performance" />
                    <ListBoxItem Content="🔒  Privacy" />
                    <ListBoxItem Content="⬇  Downloads" />
                    <ListBoxItem Content="⌨  Shortcuts" />
                    <ListBoxItem Content="📦  Profiles" />
                    <ListBoxItem Content="🧩  Extensions" />
                    <ListBoxItem Content="ℹ  About" />
                </ListBox>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <ContentControl x:Name="PanelHost" />
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0" Background="{DynamicResource TabSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="No unsaved changes" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Content="Reset" Padding="14,7" Margin="0,0,8,0" Click="OnReset" />
                <Button Grid.Column="2" Content="Clear data…" Padding="14,7" Margin="0,0,8,0" Click="OnClearData" />
                <Button Grid.Column="3" Content="Save" Padding="18,7" FontWeight="SemiBold" Style="{StaticResource AccentButton}" Click="OnSave" />
            </Grid>
        </Border>
    </Grid>
</Window>

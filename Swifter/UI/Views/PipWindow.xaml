<Window x:Class="Swifter.UI.Views.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swifter PiP"
        Width="420" Height="260"
        MinWidth="240" MinHeight="150"
        WindowStyle="None"
        AllowsTransparency="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0A0A0C"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Left="1100" Top="700"
        MouseLeftButtonDown="OnDragStart"
        StateChanged="OnStateChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#E0101014" Padding="8,5" Cursor="SizeAll" MouseLeftButtonDown="OnDragStart">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⧉" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="Picture in Picture" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#EEEEEE" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="TopmostBtn" Content="📌" Width="26" Height="22" Background="Transparent" BorderThickness="0" Foreground="#DDDDDD" Cursor="Hand" Click="OnTopmostToggle" ToolTip="Toggle always on top" />
                    <Button x:Name="CloseBtn" Content="✕" Width="26" Height="22" Background="Transparent" BorderThickness="0" Foreground="#DDDDDD" Cursor="Hand" Click="OnCloseClick" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#000000" CornerRadius="0">
            <ContentControl x:Name="VideoHost" />
        </Border>
        <Border Grid.Row="2" Background="#E0101014" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="⏮" Width="34" Height="26" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Click="OnBack10" ToolTip="Back 10s" />
                <Button Grid.Column="1" Content="⏯" Width="34" Height="26" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Click="OnPlayPause" ToolTip="Play / pause" />
                <Button Grid.Column="2" Content="⏭" Width="34" Height="26" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Click="OnForward10" ToolTip="Forward 10s" />
                <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="1" Value="1" Margin="10,0" VerticalAlignment="Center" ValueChanged="OnVolumeChanged" ToolTip="Volume" />
                <Button Grid.Column="4" Content="🔊" Width="30" Height="26" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Click="OnMute" ToolTip="Mute" />
                <Button Grid.Column="5" Content="⛶" Width="30" Height="26" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Click="OnOpenOriginal" ToolTip="Open source page" />
            </Grid>
        </Border>
    </Grid>
</Window>
